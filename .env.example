# MassLab Phase 0 environment template.
# Copy this file to `.env` and fill in real values from `supabase start`.
# Constitution v1.1.1: legacy `SUPABASE_ANON_KEY` and `SUPABASE_SERVICE_ROLE_KEY`
# keys are FORBIDDEN. The config schema rejects them at boot.

# When `true`, the auth middleware resolves every request to the seeded athlete.
# When `false`, requests must carry a valid Supabase-issued bearer token.
SINGLE_USER_MODE=true

# Express HTTP port.
PORT=3000

# Supabase API URL (printed by `supabase start` — e.g. http://127.0.0.1:54321).
SUPABASE_URL=

# Server-only secret key (`sb_secret_…`). NEVER expose to the frontend.
# Replaces the legacy `SUPABASE_SERVICE_ROLE_KEY` (which is forbidden here).
SUPABASE_SECRET_KEY=

# Browser-safe publishable key (`sb_publishable_…`).
# Replaces the legacy `SUPABASE_ANON_KEY` (which is forbidden here).
SUPABASE_PUBLISHABLE_KEY=

# Allowed origin for CORS in development (Vite dev server default).
CORS_ORIGIN=http://localhost:5173

# --- Phase 2: Settings & Data Management ---
# Backup envelope schema version emitted by /data/export/json. Bump when the
# envelope shape changes; the import path uses this to walk forward-migrators.
BACKUP_SCHEMA_VERSION=1

# Hard ceiling on /data/import upload size in bytes. Default: 25 MiB.
IMPORT_MAX_BYTES=26214400

# Separator used by the sessions CSV exporter (RFC 4180 quoting still applies).
CSV_SEPARATOR=,

# Server-side typed-token required for /data/reset. The frontend prompt is UX;
# this string is the source of truth.
RESET_CONFIRM_TOKEN=RESET-MASSLAB

# Phase 3 — exercise media. Upload size ceiling in bytes (default 25 MiB) and
# comma-separated MIME allowlists for image / local-video uploads.
EXERCISE_MEDIA_MAX_BYTES=26214400
EXERCISE_MEDIA_IMAGE_TYPES=image/jpeg,image/png,image/webp
EXERCISE_MEDIA_VIDEO_TYPES=video/mp4,video/webm
# Privacy-enhanced YouTube embed host used to render exercise videos.
YOUTUBE_EMBED_HOST=https://www.youtube-nocookie.com
# Filesystem root for uploaded exercise media (default storage adapter).
PHOTO_STORAGE_ROOT=data/photos

# Phase 6 — Body progress photos. Upload size cap (bytes) and allowed MIME types.
BODY_PHOTO_MAX_BYTES=26214400
BODY_PHOTO_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Phase 7 — Nutrition. Daily hydration goal in mL.
HYDRATION_GOAL_ML=3000
# Phase 7 — Nutrition. Rolling window in days for nutrition trends.
NUTRITION_TREND_DAYS=30
# Phase 7 — Nutrition. Locale for number/date formatting.
NUTRITION_LOCALE=fr-FR

# Phase 8 — Supplements. Slug of the supplement whose streak is shown most prominently.
SUPPLEMENT_PRIMARY_SLUG=creatine-monohydrate
# Phase 8 — Supplements. Rolling window in weeks for the self-assessment trend.
SUPPLEMENT_ASSESSMENT_TREND_WEEKS=12

# Phase 9 — Recovery & Wellbeing. Rolling window (days) for the energy/stress/sleep overlay.
RECOVERY_TREND_DAYS=30
# Phase 9 — Recovery alerts (all configurable; defaults match the spec clarification).
# High-stress/cortisol warning: stress >= RECOVERY_STRESS_HIGH (0–10) for
# RECOVERY_STRESS_HIGH_DAYS consecutive check-in days.
RECOVERY_STRESS_HIGH=7
RECOVERY_STRESS_HIGH_DAYS=3
# Reduce-volume recommendation: avg sleep <= RECOVERY_SLEEP_LOW_HOURS AND avg energy <=
# RECOVERY_ENERGY_LOW (0–10) over the last RECOVERY_LOW_WINDOW_DAYS days.
RECOVERY_SLEEP_LOW_HOURS=6
RECOVERY_ENERGY_LOW=4
RECOVERY_LOW_WINDOW_DAYS=3
# Full-rest suggestion: >= RECOVERY_REST_SIGNALS of {low sleep, low energy, high stress}
# in one day, OR >= RECOVERY_SORE_ZONES_REST sore zones in a day.
RECOVERY_REST_SIGNALS=3
RECOVERY_SORE_ZONES_REST=4
# Phase 9 — allowed mood keys (UI maps to emoji + localized label) and sore-zone list
# (clickable body-diagram regions). Surfaced by GET /recovery/checkin so the UI hardcodes neither.
RECOVERY_MOOD_OPTIONS=great,good,ok,low,bad
RECOVERY_SORE_ZONES=neck,shoulders,chest,upper_back,lower_back,biceps,triceps,forearms,abs,glutes,quads,hamstrings,calves

# Phase 10 — Dashboard (read-only home screen; no migration). All optional.
# Consecutive elapsed SCHEDULED training days with no completed session that trigger the
# "no session" smart alert (rest days never count).
DASHBOARD_NO_SESSION_DAYS=2
# Yesterday's calories under this fraction of the resolved daily target = calorie-deficit alert.
DASHBOARD_CALORIE_DEFICIT_PCT=0.9
# Window (days) for the home-screen weight sparkline.
DASHBOARD_WEIGHT_SPARKLINE_DAYS=30

# Phase 11 — Statistics & Global Progress (read-only composition; no migration). All optional.
# Number of top exercises surfaced in the strength leaderboards.
STATISTICS_TOP_EXERCISES=5
# Number of top progressions included in the exported PDF report.
STATISTICS_REPORT_TOP_PROGRESSIONS=3
# Number of intensity buckets in the attendance heatmap.
STATISTICS_HEATMAP_LEVELS=4
# Minimum paired data points required before a correlation (e.g. sleep vs weight) is computed.
STATISTICS_MIN_CORRELATION_POINTS=3

# Phase 4 — Session Journal. The auto-save cadence is a FRONTEND Vite build var
# (optional; defaults to 30000 ms in frontend/src/lib/sessionConfig.js). The backend
# reads no Phase 4 key.
# VITE_SESSION_AUTOSAVE_INTERVAL_MS=30000
