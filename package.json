{
  "name": "masslab",
  "version": "0.1.0-phase0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "start": "concurrently -n api,web -c blue,green \"node server.js\" \"npm --prefix frontend run dev\"",
    "dev": "npm start",
    "seed": "node seed/runSeed.js",
    "db:reset": "supabase db reset && npm run seed",
    "test": "vitest run",
    "test:contract": "vitest run --project contract",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.1.1",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "eslint": "^9.10.0",
    "globals": "^15.9.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^25.0.0",
    "openapi-types": "^12.1.3",
    "pino-pretty": "^11.2.2",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "vitest": "^2.1.1"
  }
}
